<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.EmpMapper">
	<!-- 여러개 검색 -->
	<select id="selectEmpList" resultType="com.example.demo.model.Emp">
		SELECT E.*, GRADE FROM EMP E 
		INNER JOIN SALGRADE S
		ON E.SAL BETWEEN S.LOSAL AND S.HISAL
		WHERE 1=1
		<if test="grade != null and grade != ''">
			AND GRADE = #{grade}
		</if>
	</select>
	
	<!--한 개 검색 (pk - 사번) -->
	<select id="selectEmp" parameterType="hashmap" resultType="com.example.demo.model.Emp">
		SELECT * FROM EMP WHERE EMPNO = #{empNo}
	</select>
	
	<!-- 삭제 -->
	<delete id="deleteEmp" parameterType="hashmap"> 
		DELETE FROM EMP WHERE EMPNO = #{empNo} 
		<!-- 이렇게 #{키}로 값 꺼낼 수 있음. -->
	</delete>
	
	<!-- 삽입 -->
	<insert id="insertEmp" parameterType="hashmap">
		INSERT INTO EMP (EMPNO, ENAME, JOB, SAL) 
		VALUES (#{empNo}, #{eName}, #{job}, #{sal})
	</insert>
	
	<!--급여등급 목록 조회-->
	<select id="selectGradeList" resultType="com.example.demo.model.Emp">
		SELECT * FROM SALGRADE
	</select>
</mapper>
