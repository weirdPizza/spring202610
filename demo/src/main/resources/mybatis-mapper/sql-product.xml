<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.ProductMapper">
	<select id="selectProductList" parameterType="hashMap" resultType="com.example.demo.model.Product">
		SELECT P.*, ROUND(PRICE) CONVERT_PRICE
		FROM PRODUCT P
		<!--xml 에서 elseif 란 태그는 없음 else조건은 case문 같은 where 쓰면 됨-->
		WHERE STATUS = 'SALE'
		<if test="category!='' and category != null">
			AND CATEGORY = #{category}
		</if>
		<choose>
			<when test="order == 1">
				ORDER BY PRICE ASC
			</when>
			<when test="order == 2">
				ORDER BY PRICE DESC
			</when>
			<when test="order == 3">
				ORDER BY RELEASE_DATE DESC
			</when>
			<otherwise>
				ORDER BY PRODUCT_ID ASC
			</otherwise>
		</choose>
	</select>
	
	<select id="selectCategoryList" parameterType="hashMap" resultType="com.example.demo.model.Product">
		SELECT DISTINCT CATEGORY FROM PRODUCT
	</select>
	
	<select id="selectProduct" parameterType="hashMap" resultType="com.example.demo.model.Product">
		SELECT * , ROUND(PRICE) CONVERT_PRICE
		FROM PRODUCT
		WHERE PRODUCT_ID = #{productId};
	</select>
	
	<select id="selectProductFile" parameterType="hashmap" resultType="com.example.demo.model.File">
		SELECT * FROM PRODUCT_FILE
		WHERE PRODUCT_ID = #{productId}
	</select>
	
	<!-- 삭제를 빙자한 업데이트 -->
	<update id="deleteProduct" parameterType="hashmap">
		UPDATE PRODUCT
		SET STATUS = 'STOP'
		WHERE PRODUCT_ID = #{productId} 
	</update>
	
	<!--추가-->
	<insert id="insertProduct" parameterType="hashmap"  useGeneratedKeys="true" keyColumn="PRODUCT_ID" keyProperty="productId">
		INSERT INTO PRODUCT (PRODUCT_ID, PRODUCT_NAME, CATEGORY, DESCRIPTION, STATUS, CDATETIME)
		VALUES (NULL, #{productName}, #{category}, #{description}, 'SALE', NOW())
	</insert>
	
	<insert id="insertProductFile" parameterType="hashmap">
		INSERT INTO PRODUCT_FILE
		VALUES(NULL, #{idx}, #{path}, #{fileName}, #{orgName}, #{size}, #{extName})
	</insert>
</mapper>